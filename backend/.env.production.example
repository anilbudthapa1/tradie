# Tradie Job Manager — production env template for defecexinso.com
#
# Copy to backend/.env.production on the server (NOT committed).
# Generate JWT_SECRET with: openssl rand -hex 32
# Every "change-me" below is required before first launch.

APP_ENV=production
PORT=8080

BASE_URL=https://api.defecexinso.com
FRONTEND_URL=https://defecexinso.com

# ── Data layer ──────────────────────────────────────────────────────
# Use a managed Postgres (Neon, Supabase, RDS) with sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tradie?sslmode=require
# Use a managed Redis (Upstash works well; free tier covers small load).
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Activate per-request RLS hooks (migration 000043 must already be applied).
RLS_ENABLED=true

# ── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

WEBAUTHN_RP_ID=defecexinso.com
WEBAUTHN_RP_NAME=Tradie Job Manager

# ── Object storage (Cloudflare R2 — S3-compatible, no egress fees) ──
S3_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=tradie-prod
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_USE_PATH_STYLE=true

# ── Stripe (live keys) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_PRICE_PRO=price_change_me
STRIPE_PRICE_ENTERPRISE=price_change_me

# ── Email (SendGrid) ────────────────────────────────────────────────
SENDGRID_API_KEY=SG.change_me
EMAIL_FROM=billing@defecexinso.com
EMAIL_FROM_NAME=Tradie Job Manager

# ── SMS (Twilio — optional, leave blank to disable) ─────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Maps + AI ───────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=change_me
ANTHROPIC_API_KEY=sk-ant-change_me

# ── Observability ───────────────────────────────────────────────────
SENTRY_DSN=
