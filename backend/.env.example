APP_ENV=development
PORT=8080

DATABASE_URL=postgres://USER:PASSWORD@localhost:5433/DATABASE?sslmode=disable
REDIS_URL=redis://:PASSWORD@localhost:6380/0

JWT_SECRET=change-this-secret

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-this
S3_SECRET_KEY=change-this
S3_BUCKET=tradie
S3_REGION=us-east-1
S3_USE_SSL=false

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-this
MINIO_SECRET_KEY=change-this
MINIO_USE_SSL=false

# Multi-tenant Row-Level Security backstop (migration 000043).
# When true, every pool acquire calls set_tenant() with the request's
# business_id, activating the tenant_isolation policy on every per-tenant
# table. Leave false until you've applied migration 000043 and run
# integration tests; flip to true in production after smoke-testing.
RLS_ENABLED=false
