# Server
APP_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://tradie:tradie_secret@localhost:5432/tradie?sslmode=disable

# Redis
REDIS_URL=redis://:redis_secret@localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-2
S3_BUCKET=tradie
S3_ACCESS_KEY=tradie_minio
S3_SECRET_KEY=tradie_minio_secret
S3_USE_PATH_STYLE=true

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# SendGrid
SENDGRID_API_KEY=SG....
EMAIL_FROM=noreply@tradiejobmanager.com.au
EMAIL_FROM_NAME=Tradie Job Manager

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+61...

# Google Maps
GOOGLE_MAPS_API_KEY=AIza...

# WebAuthn (Passkey)
WEBAUTHN_RP_ID=tradiejobmanager.com.au
WEBAUTHN_RP_NAME=Tradie Job Manager
WEBAUTHN_RP_ORIGINS=https://tradiejobmanager.com.au,http://localhost:3000

# Monitoring
SENTRY_DSN=https://...@sentry.io/...
